{# Posts to your Kit "Interview guide" form (site.json > kit.guideFormId). Kit emails the guide PDF as the form's incentive email. #}
<section class="page-head">
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / Free BA interview guide</nav>
  </div>
</section>
<section class="section" style="padding-top:0">
  <div class="wrap split" style="grid-template-columns:1.2fr 1fr">
    <div class="prose">
      <p class="eyebrow">Free download</p>
      <h1 style="font-size:var(--step-4)">The business analyst interview guide</h1>
      <p class="lead">The questions hiring managers actually ask business analysts, and how to answer them in a way that shows judgement, not memorised theory.</p>
      <h2>What you'll learn</h2>
      <ul>
        <li>The question types that come up in almost every BA interview, and what each one is really testing</li>
        <li>How to structure scenario answers around real situations from your own experience</li>
        <li>How to talk about requirements, stakeholders and process work if you're coming from a different role</li>
        <li>The mistakes that quietly cost strong candidates the offer</li>
      </ul>
      <p>Written by Tosin Ogunkoya, drawing on thirteen years in business analysis and more than three thousand people trained.</p>
    </div>
    <form class="form-card" method="POST" action="https://app.kit.com/forms/{{ site.kit.guideFormId }}/subscriptions">
      <h2 style="font-size:var(--step-1)">Send me the guide</h2>
      <label for="g-name">First name</label>
      <input id="g-name" name="fields[first_name]" autocomplete="given-name" required>
      <label for="g-email">Email address</label>
      <input id="g-email" type="email" name="email_address" autocomplete="email" required>
      <button class="btn" type="submit">Email me the free guide</button>
      <p class="form-note">You'll also get one practical BA lesson a week. Unsubscribe any time. See the <a href="/privacy-policy/">privacy policy</a>.</p>
    </form>
  </div>
</section>
<section class="section section-alt">
  <div class="wrap">
    <div class="section-head"><h2>Questions about the guide</h2></div>
    <div class="faq">
      {%- for f in faqs %}<details><summary>{{ f.q }}</summary><p>{{ f.a }}</p></details>{% endfor %}
    </div>
  </div>
</section>
