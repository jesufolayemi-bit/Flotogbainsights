<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="{{ site.name }} home">
      <img class="brand-mark" src="{{ site.logo }}" width="44" height="44" alt="">
      <span>Flotog <span class="brand-sub">BA Insights</span></span>
    </a>
    <nav class="main-nav" aria-label="Main">
      <input type="checkbox" id="nav-toggle" class="nav-toggle">
      <label for="nav-toggle" class="nav-toggle-label">Menu</label>
      <ul>
        {%- for item in nav %}
        <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
        <li><a class="btn btn-small" href="{{ site.booking.freeConsultation }}">Book a free call</a></li>
      </ul>
    </nav>
  </div>
</header>
